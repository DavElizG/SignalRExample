# Database Connection - Replace with your actual database details
DB_CONNECTION_STRING=Server=your_server;Port=your_port;Database=your_database;User=your_username;Password=your_password;SslMode=Preferred;AllowPublicKeyRetrieval=true;ConnectionTimeout=30;DefaultCommandTimeout=30;

# CORS Origins (separados por comas si hay múltiples)
CORS_ORIGINS=http://localhost:5173

# Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# Configuración adicional
ENABLE_SWAGGER=true
APPLY_MIGRATIONS=true